    dplyr (>= 1.1.0),
    ggplot2 (>= 4.0.0),
    ggtext,
    grDevices,
    ggrepel,
    rlang,
    scales,
    stats,
    systemfonts,
    tibble,
    tidyr,
    utils
Suggests:
